# Copy to backend/.env for local development. Never commit backend/.env.
# Production values are set directly in PythonAnywhere's Web tab
# environment variables, never checked into the repo.
#
# Variable names below match what backend/config.py and backend/rate_limit.py
# actually read (verified Phase 12) — placeholders only, no real values.

# development | production
FLASK_ENV=development

# Flask's session/cookie signing key. Generate a unique value per
# environment, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# Must differ from the insecure dev-only default in backend/config.py.
SECRET_KEY=changeme-generate-a-unique-random-value

# SQLAlchemy database URL. Omit/leave unset to fall back to
# backend/db/session.py's default (backend/db/churnai.db). In production,
# point this at a SQLite file outside any web-served or git-tracked path,
# e.g.: sqlite:////home/<username>/churnai_data/churnai.db
DATABASE_URL=

# Comma-separated allow-list of origins allowed to call the API with
# credentials. Never a wildcard ("*"). Include the real deployed frontend
# origin(s) in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# true in production (cookie only sent over HTTPS); false for local HTTP dev.
SESSION_COOKIE_SECURE=false

# Session lifetime in days from issuance.
SESSION_TTL_DAYS=7

# Password reset token lifetime in minutes.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Max upload size in MB (also derives Flask's MAX_CONTENT_LENGTH).
CHURNAI_MAX_UPLOAD_SIZE_MB=25

# Optional: override where uploaded CSVs / generated reports are stored.
# Defaults to backend/storage/uploads and backend/storage/reports if unset.
# CHURNAI_UPLOAD_DIR=
# CHURNAI_REPORTS_DIR=

# Rate limiting (Phase 11, backend/rate_limit.py). Flask-Limiter storage URI;
# "memory://" is fine for the free-tier single-worker deployment target.
CHURNAI_RATE_LIMIT_ENABLED=true
CHURNAI_RATE_LIMIT_STORAGE_URI=memory://
CHURNAI_RATE_LIMIT_AUTH=20 per minute
CHURNAI_RATE_LIMIT_TRAINING=10 per minute
CHURNAI_RATE_LIMIT_PREDICTION=60 per minute
